# =============================================================================
# Dexter HMS - Runtime environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.
#
# Priority: DB (LCD menu) takes precedence over .env values.
# .env values are fallbacks used when the DB field is empty
# (e.g. fresh device before first LCD provisioning, or Docker).
# =============================================================================

# ── Device Identity ───────────────────────────────────────────────────────────
DEVICE_NAME=BRANCH_001

# ── ThingsBoard / MQTT Broker ─────────────────────────────────────────────────
MQTT_BROKER=thingsboard.cloud

# ── Network Mode ─────────────────────────────────────────────────────────────
# Determines MQTT auth path on first boot (seeds modem_config.db).
# Leave commented-out to use the value already in the DB (set via LCD / web panel).
# For fresh Docker GSM devices: uncomment and set to gsm.
# For fresh Docker Ethernet devices: leave commented-out (default is ethernet).
# NETWORK_TYPE=ethernet

# ── Access Token auth (Ethernet/Wi-Fi path) ───────────────────────────────────
# Used by thingsboard_mqtt_publisher.py when access_token is empty in DB
MQTT_TOKEN=YOUR_ACCESS_TOKEN_HERE

# ── MQTT Basic auth (Cavli cellular modem path) ───────────────────────────────
# Used by cavlidata.py when network_type is gsm and credentials are empty in DB
MQTT_CLIENT_ID=YOUR_CLIENT_ID_HERE
MQTT_USER_NAME=YOUR_USERNAME_HERE
MQTT_PASSWORD=YOUR_PASSWORD_HERE

# ── Portainer Fleet Management ────────────────────────────────────────────────
# portainer_register() in Lan_setting.py calls the Portainer API at end of
# device_provisioning() to auto-create an Edge environment named after the
# device_name in modem_config.db and write PORTAINER_EDGE_ID + PORTAINER_EDGE_KEY
# back into this file. No manual setup needed per Pi.
#
# PORTAINER_SERVER   — URL of your Portainer CE instance
# PORTAINER_API_TOKEN — Portainer admin API token
#   Generate: Portainer UI → top-right avatar → My account → Access tokens → Add
PORTAINER_SERVER=https://3.111.214.115:9443
PORTAINER_API_TOKEN=YOUR_PORTAINER_API_TOKEN_HERE

# Written automatically by portainer_register() — do not edit manually:
PORTAINER_EDGE_ID=
PORTAINER_EDGE_KEY=

# ── Docker ────────────────────────────────────────────────────────────────────
# Docker image to run (set by CI/CD pipeline on each OTA push).
# ECR URI: 901178127457.dkr.ecr.ap-south-1.amazonaws.com/dexter-edge
# For local dev/test builds: DEXTER_IMAGE=dexter-edge:latest
# For ECR fleet deployments:
DEXTER_IMAGE=901178127457.dkr.ecr.ap-south-1.amazonaws.com/dexter-edge:latest

# ── OTA — ECR pull credentials ───────────────────────────────────────────────
# Used by docker/ota_update.sh (runs hourly via cron) to log into ECR and
# pull a new dexter-edge:latest when available.
# Run once on each Pi to store credentials:
#   aws ecr get-login-password --region ap-south-1 | \
#     docker login --username AWS --password-stdin \
#     901178127457.dkr.ecr.ap-south-1.amazonaws.com
# Cron refreshes the token every 6h (added automatically by provisioning).
AWS_ECR_ACCESS_KEY_ID=YOUR_ECR_KEY_ID_HERE
AWS_ECR_SECRET_ACCESS_KEY=YOUR_ECR_SECRET_HERE
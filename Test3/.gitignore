# Virtual environments
.venv/
venv/
env/

# Database files
*.db
*.db-shm
*.db-wal

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE
.idea/

# Environment / secrets — never commit real credentials
.env
*.env
!.env.example

# Claude Code session memory
.claude/

# Generated HTML report artifacts
daily_reports/*.html

# X.509 PKI — private keys and generated certs must NEVER be committed
certs-ca/
certs-out/
# Pi-deployed certs (if ever copied back locally)
certs/

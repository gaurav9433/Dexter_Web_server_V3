# Normalize line endings to LF on commit (Linux target)
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.target text eol=lf
*.timer text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.md text eol=lf
*.crt text eol=lf
*.pem text eol=lf

# Binary files — no line-ending conversion
*.db binary
*.key binary
*.p12 binary
[Unit]
Description=Dexter HMS — RPi System Health Monitor
PartOf=dexter.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Test3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/Test3/RPi_Task_Manager.py
Restart=on-failure
RestartSec=10
WatchdogSec=7200
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dexter-rpi-task
MemoryMax=256M
CPUQuota=80%
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=dexter.target

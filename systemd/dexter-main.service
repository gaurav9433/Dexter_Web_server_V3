[Unit]
Description=Dexter HMS — Main Panel Controller
After=network-online.target
Wants=network-online.target
PartOf=dexter.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Test3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/Test3/TLChronosProMAIN_391.py
Restart=on-failure
RestartSec=10
WatchdogSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dexter-main
MemoryMax=256M
CPUQuota=80%
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=dexter.target

[Unit]
Description=Dexter HMS — CP Plus RTC Clock Sync
After=network-online.target
Wants=network-online.target
PartOf=dexter.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Test3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/Test3/cp_plus_RTC_sync.py
Restart=on-failure
RestartSec=10
WatchdogSec=7200
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dexter-rtc-cpplus
MemoryMax=256M
CPUQuota=80%
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=dexter.target

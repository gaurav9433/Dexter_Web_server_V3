[Unit]
Description=Dexter HMS — Texecom BAS Active Integration
After=network-online.target
Wants=network-online.target
PartOf=dexter.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Test3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/Test3/texecomConnect_Python3_testing_currently_working_DateTimeSync_power_4.py
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=0 1
WatchdogSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dexter-texecom-bas
MemoryMax=128M
CPUQuota=30%
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=dexter.target
